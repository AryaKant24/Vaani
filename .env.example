# Copy this file to .env and replace placeholder values.
# Never commit .env or real API keys.

# PostgreSQL connection (create the database and role as described in README.md).
DATABASE_URL=postgresql://vani_app:change_this_password@127.0.0.1:5432/vani
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
SESSION_HTTPS_ONLY=false

# Gnani Vachana credential used for speech-to-text and Timbre text-to-speech.
GNANI_API_KEY=

# OpenAI-compatible reasoning endpoint.
# The default points to Groq's chat-completions API.
GNANI_EVON_URL=https://api.groq.com/openai/v1/chat/completions

# Supply the key for the endpoint above. GROQ_API_KEY is preferred for Groq.
GROQ_API_KEY=

# Optional alternatives:
# LLM_API_KEY=
# GEMINI_API_KEY=

# Reasoning model sent to the configured endpoint.
LLM_MODEL=openai/gpt-oss-120b

# Default language and voice used when a request does not provide them.
DEFAULT_LANGUAGE=en-IN
DEFAULT_VOICE=Shlok

# Gnani Timbre model.
TTS_MODEL=timbre-v2.5
